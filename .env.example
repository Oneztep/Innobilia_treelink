# Variables de entorno para Innobilia
# Copia este archivo como .env.local y ajusta los valores

# Clave secreta para el enlace de acceso de administradores.
# Cámbiala antes de publicar — no uses el valor por defecto.
VITE_ADMIN_SECRET="cambiar-antes-de-publicar"

# URL pública de la app (usada para el enlace de admin y SEO).
# En producción: https://innobilia.com
VITE_APP_URL="http://localhost:3000"
