# Handle line endings automatically for all files
* text=auto eol=lf

# Force LF for these file types
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf

# Binary files — never convert
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
