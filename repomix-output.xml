<file path="src/index.css">
/* ── Fonts: Playfair Display (serif elegante) + DM Sans (cuerpo moderno) ── */
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap');
@import "tailwindcss";

/* ── Design tokens ──────────────────────────────────────────────────────── */
@theme {
  --font-sans: "DM Sans", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Playfair Display", Georgia, serif;
  --font-mono: "DM Mono", ui-monospace, SFMono-Regular, monospace;

  /* Icon palette — #0f172b dark / #ffb900 gold / #fe9a00 signal */
  --color-ink:       #0a0f1e;
  --color-ink-soft:  #0f172b;
  --color-gold:      #ffb900;
  --color-gold-lt:   #ffd040;
  --color-gold-dim:  #cc9a00;
  --color-signal:    #fe9a00;
  --color-signal-lt: #ffc340;
  --color-cream:     #faf9f7;
  --color-cream-dim: #f1f0ec;
  --color-slate-1:   #1e293b;
  --color-slate-2:   #334155;
  --color-slate-3:   #64748b;
  --color-slate-4:   #94a3b8;
}

/* ── Base ───────────────────────────────────────────────────────────────── */
@layer base {
  /* Hover-only scrollbar for clean modals */
  .scrollbar-hover::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .scrollbar-hover::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-hover::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 10px;
  }
  .scrollbar-hover:hover::-webkit-scrollbar-thumb,
  .scrollbar-hover:active::-webkit-scrollbar-thumb {
    background: rgba(100, 116, 139, 0.5); /* slate-500 semi-transparent */
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background-color: #f8fafc;
    color: #0f172b;
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
  }

  /* Scrollbar minimalista */
  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
  ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
}

/* ── Grain overlay ──────────────────────────────────────────────────────── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.018;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
  background-size: 128px 128px;
}

/* El contenido va sobre el grain */
#root { position: relative; z-index: 1; }

/* ── Blur backdrop ──────────────────────────────────────────────────────── */
.backdrop-blur-md-custom {
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
}

/* ── Smooth transitions ─────────────────────────────────────────────────── */
.smooth-transition {
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ── FiltersBar dropdown (rendering-hoist-jsx: moved from inline style tag) ── */
@keyframes selectDropIn {
  from { opacity: 0; transform: translateY(-6px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0)   scale(1);    }
}
.custom-scrollbar::-webkit-scrollbar { width: 4px; }
.custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

/* ── Design-token focus ring — luxury icon gold (#ffb900) ───────────────── */
/* Overrides Tailwind amber focus so every input uses the exact icon palette. */
[class*="focus:border-amber"]:focus {
  border-color: #ffb900 !important;
}
[class*="focus:ring-amber"]:focus {
  --tw-ring-color: rgba(255, 185, 0, 0.2);
  box-shadow: 0 0 0 3px rgba(255, 185, 0, 0.2) !important;
}

/* ── Property card selected — gold shimmer border ───────────────────────── */
.property-card-selected {
  position: relative;
  border-color: transparent !important;
  box-shadow:
    0 0 0 1.5px rgba(255, 185, 0, 0.7),
    0 8px 32px rgba(255, 185, 0, 0.14),
    0 2px 8px rgba(0,0,0,0.06);
}

.property-card-selected::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1.5px;
  background: linear-gradient(135deg, #ffb900, #ffd040, #fe9a00, #ffb900);
  background-size: 300% 300%;
  animation: goldShimmer 3s ease infinite;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  z-index: 0;
}

@keyframes goldShimmer {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ── Carousel animation ─────────────────────────────────────────────────── */
@keyframes carouselFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.carousel-img-enter {
  animation: carouselFadeIn 0.35s ease-out;
}

/* Hover zoom on carousel image */
.carousel-container img {
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.carousel-container:hover img {
  transform: scale(1.06);
}

/* ── Staggered fade-up for property cards ───────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-up {
  animation: fadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.fade-up-1 { animation-delay: 0.05s; }
.fade-up-2 { animation-delay: 0.10s; }
.fade-up-3 { animation-delay: 0.15s; }
.fade-up-4 { animation-delay: 0.20s; }
.fade-up-5 { animation-delay: 0.25s; }
.fade-up-6 { animation-delay: 0.30s; }

/* ── Gold badge pulse ───────────────────────────────────────────────────── */
@keyframes pricePulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 185, 0, 0.5); }
  50%       { box-shadow: 0 0 0 4px rgba(255, 185, 0, 0); }
}
.price-badge {
  animation: pricePulse 2.5s ease-in-out infinite;
}

/* ── Glass card utility ─────────────────────────────────────────────────── */
.glass-card {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px) saturate(1.8);
  -webkit-backdrop-filter: blur(20px) saturate(1.8);
  border: 1px solid rgba(255, 255, 255, 0.5);
}

/* ── Hero ambient glow ──────────────────────────────────────────────────── */
.hero-glow::before {
  content: '';
  position: absolute;
  top: -60px;
  left: 50%;
  transform: translateX(-50%);
  width: 400px;
  height: 400px;
  background: radial-gradient(ellipse at center, rgba(255, 185, 0, 0.07) 0%, transparent 70%);
  pointer-events: none;
}

/* ── Toast ──────────────────────────────────────────────────────────────── */
@keyframes toastIn {
  from { opacity: 0; transform: translateY(8px) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.toast-enter {
  animation: toastIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* ── Admin banner pulse line ────────────────────────────────────────────── */
@keyframes bannerSlide {
  from { transform: translateX(-100%); }
  to   { transform: translateX(100%); }
}
.banner-shine::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 60%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
  animation: bannerSlide 2.5s ease-in-out infinite;
}

/* ── Modal open/close animations ───────────────────────────────────────── */

/* Overlay (backdrop) */
@keyframes overlayIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes overlayOut {
  from { opacity: 1; }
  to   { opacity: 0; }
}

/* Panel — scale-up spring on enter, scale-down fade on exit */
@keyframes panelIn {
  from { opacity: 0; transform: scale(0.94) translateY(8px); }
  to   { opacity: 1; transform: scale(1)    translateY(0);   }
}
@keyframes panelOut {
  from { opacity: 1; transform: scale(1)    translateY(0);   }
  to   { opacity: 0; transform: scale(0.96) translateY(6px); }
}

/* Bottom-sheet variant — slides up from bottom on mobile */
@keyframes sheetIn {
  from { opacity: 0; transform: translateY(100%); }
  to   { opacity: 1; transform: translateY(0);    }
}
@keyframes sheetOut {
  from { opacity: 1; transform: translateY(0);    }
  to   { opacity: 0; transform: translateY(100%); }
}

.modal-overlay-open  { animation: overlayIn  0.22s ease both; }
.modal-overlay-close { animation: overlayOut 0.18s ease both; }

.modal-panel-open    { animation: panelIn  0.28s cubic-bezier(0.16, 1, 0.3, 1) both; }
.modal-panel-close   { animation: panelOut 0.18s cubic-bezier(0.4, 0, 1, 1) both; }

.modal-sheet-open    { animation: sheetIn  0.32s cubic-bezier(0.16, 1, 0.3, 1) both; }
.modal-sheet-close   { animation: sheetOut 0.2s  cubic-bezier(0.4, 0, 1, 1) both; }

/* ── Lightbox fullscreen gallery ─────────────────────────────────────────── */
@keyframes lightboxIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes lightboxOut {
  from { opacity: 1; }
  to   { opacity: 0; }
}
@keyframes lightboxImgIn {
  from { opacity: 0; transform: scale(0.96); }
  to   { opacity: 1; transform: scale(1); }
}

/* cursor zoom for carousel images */
.cursor-zoom-in { cursor: zoom-in; }

/* ── Skeleton loading shimmer ────────────────────────────────────────────── */
@keyframes skeletonShimmer {
  0%   { background-position: -400px 0; }
  100% { background-position:  400px 0; }
}

.skeleton-shimmer {
  background: linear-gradient(
    90deg,
    #f1f5f9 25%,
    #e2e8f0 50%,
    #f1f5f9 75%
  );
  background-size: 800px 100%;
  animation: skeletonShimmer 1.4s ease-in-out infinite;
}

.skeleton-card {
  background: #fff;
  animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
}
