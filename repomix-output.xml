}

export interface Appointment {
  id: string;
  propertyId: string;
  propertyTitle: string;
  clientName: string;
  clientLastName: string;
  clientEmail: string;
  clientPhone: string;
  budget: number;
  date: string; // YYYY-MM-DD
  time?: string;
  notes?: string;
